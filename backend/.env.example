# ── Database ─────────────────────────────────────────────────
# SQLite (local dev, default)
DATABASE_URL=sqlite+aiosqlite:///./knowledge_hub.db

# PostgreSQL via Supabase (production)
# Use the Transaction Mode pooler (port 6543) for serverless compatibility
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Auth ──────────────────────────────────────────────────────
# Generate a strong random key: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here

# ── Admin ─────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Content ───────────────────────────────────────────────────
# Path to the directory containing section folders with .md notes
# Default: backend/content/ (relative to the backend directory)
# CONTENT_DIR=/path/to/content
